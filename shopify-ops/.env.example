# ── Shopify ────────────────────────────────────────────────────────────────
# Dominio tecnico de la tienda, SIEMPRE con .myshopify.com (no el dominio custom)
SHOPIFY_STORE=mitienda.myshopify.com
# Admin API access token de una app custom (empieza por shpat_)
SHOPIFY_ADMIN_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Version de la Admin API. Cambiala solo si Shopify deprecia la actual.
SHOPIFY_API_VERSION=2025-07

# ── Meta (Facebook / Instagram) ────────────────────────────────────────────
# act_XXXXXXXXX  (incluye el prefijo act_)
META_AD_ACCOUNT_ID=act_000000000000000
META_ACCESS_TOKEN=
META_PIXEL_ID=
META_PAGE_ID=
META_INSTAGRAM_ACTOR_ID=
META_API_VERSION=v21.0

# ── TikTok Ads ─────────────────────────────────────────────────────────────
TIKTOK_ADVERTISER_ID=
TIKTOK_ACCESS_TOKEN=
TIKTOK_PIXEL_ID=
TIKTOK_IDENTITY_ID=

# ── Moneda y zona para los informes ────────────────────────────────────────
CURRENCY=EUR
TIMEZONE=Europe/Madrid
